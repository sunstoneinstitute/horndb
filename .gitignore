/target
crates/*/target/
Cargo.lock.bak
*.swp
.DS_Store
crates/harness/data/

# Shared, version-keyed vendored GraphBLAS build (built once per (target,
# version) and reused across worktrees). See crates/closure/INTEGRATION-NOTES.md.
crates/closure/vendor/.shared-build/

# Claude Code local state.
# `.claude/skills/` IS tracked (project-shared skills).
# `.claude/worktrees/` and per-user settings are not.
.claude/worktrees/
.claude/settings.local.json
.claude/CLAUDE.local.md
.worktrees

# Visual brainstorming companion scratch
.superpowers/
/.superpowers
/.horndb-shared-target/
__pycache__

# Internal RDFox comparison results — must never be committed (DeWitt clause).
/scripts/bench/results/

# graphify local knowledge graph — AST-derived, rebuild with `graphify update .`
# Un-anchored so per-crate graphs (e.g. crates/sparql/graphify-out/) are ignored too.
graphify-out/

# Quarto build outputs. One project rooted at the repo root covers both the
# horndb.io landing page and the docs tree (rebuild with `quarto render`).
/_site/
/.quarto/
**/*.quarto_ipynb
CLAUDE.local.md
